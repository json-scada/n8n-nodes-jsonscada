    {
      "parameters": {
        "conditions": { "string": [{ "value1": "={{ $json.tag }}", "operation": "equals", "value2": "KAW2-TRIGGER" }] }
      },
      "id": "if-1",
      "name": "Trigger Tag?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "resource": "command",
        "operation": "issueCommand",
        "pointKey": 555,
        "commandValue": "1",
        "commandIsString": false
      },
      "id": "cmd-1",
