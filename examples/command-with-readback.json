      "credentials": { "jsonScadaApi": { "id": "1", "name": "JSON-SCADA API" } }
    }
  ],
  "connections": {
    "JSON-SCADA Trigger": { "main": [[{ "node": "Trigger Tag?", "type": "main", "index": 0 }]] },
    "Trigger Tag?": { "main": [[{ "node": "Issue Command", "type": "main", "index": 0 }]] },
    "Issue Command": { "main": [[{ "node": "Read Back Supervised", "type": "main", "index": 0 }]] }
  }
