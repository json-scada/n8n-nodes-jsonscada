{
  "name": "n8n-nodes-jsonscada",
  "type": "module",
  "version": "0.1.8",
  "description": "n8n community nodes to read/write JSON-SCADA (values, history, commands, alarm ack) and receive real-time notifications",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "scada",
    "json-scada",
    "iec104",
    "dnp3",
    "opc-ua",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/riclolsen/json-scada",
  "author": {
    "name": "Ricardo L. Olsen"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/json-scada/n8n-nodes-jsonscada.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JsonScadaApi.credentials.js",
      "dist/credentials/JsonScadaListener.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JsonScada/JsonScada.node.js",
      "dist/nodes/JsonScada/JsonScadaTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.0",
    "isolated-vm": "^4.7.2",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "eslint-plugin-json": "^5.0.0",
    "release-it": "^21.0.2"
  }
}
